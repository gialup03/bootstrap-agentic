# Docker service ports (shared by docker-compose and the backend)
POSTGRES_PORT=5432
REDIS_PORT=6380

# LLM Configuration
LLM_BASE_URL=https://api.writer.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=palmyra-x5

# Web search (Tavily). Get a key at https://app.tavily.com
# Optional: if unset, the web_search tool returns a clean error and the agent degrades gracefully.
TAVILY_API_KEY=
